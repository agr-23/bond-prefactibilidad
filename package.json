{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "@tmcw/togeojson": "7.1.4",
    "@turf/turf": "7.4.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "geotiff": "2.1.3",
    "jspdf": "3.0.3",
    "lucide-react": "^1.74.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "proj4": "2.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shpjs": "6.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "type": "module"
